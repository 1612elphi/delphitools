# compiled output
/dist/
/tmp/

# dependencies
/node_modules/

# misc
*.local
/.pnp*
/.eslintcache
/coverage/
*.log
*.tsbuildinfo
/.vite/
/.cache/

# broccoli-debug
/DEBUG/

# macOS noise
.DS_Store

# env: .env.development is tracked; local overrides are not
.env*.local

# claude / local-only working notes
AGENTS.md
CLAUDE.md
/.claude/
/.superpowers/

# agent worktrees and scratch clones
/.delta/
/.emdash/
/.context/

# editors
/.cursor/
/.vscode/
/.idea/
/.zed/

# wheelybin: local-only scratch
/wheelybin/

# session scratch (one-off debug/repro rigs land as root dot-files;
# anything worth keeping graduates into scripts/verify/)
/.*.mjs
!/.prettierrc.mjs
!/.stylelintrc.mjs
!/.template-lintrc.mjs

# build data (downloaded source files for dictionary builds)
/scripts/data/

# package-lock.json is tracked on purpose: CF Pages can't read the text-format
# bun.lock and would otherwise npm-install unpinned (broke the 2026-07-24 deploy)

# bun.lock stays local: CF Builds prefers it over package-lock.json, and its
# bun 1.2.15 cannot parse lockfileVersion 2
/bun.lock

# hero and art masters: the optimised webp under public/ is what ships.
# assets/og stays tracked, scripts/og.mjs reads it during build:static.
/assets/heroes/
/assets/art/
