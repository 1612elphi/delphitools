# compiled output
/dist/
/tmp/

# dependencies
/node_modules/

# misc
*.local
/.pnp*
/.eslintcache
/coverage/
/npm-debug.log*
/testem.log
/yarn-error.log

# broccoli-debug
/DEBUG/

# macOS noise
.DS_Store

# env: .env.development is tracked; local overrides are not
.env*.local

# claude / local-only working notes
CLAUDE.md
/.claude/
.superpowers/

# session scratch (one-off debug/repro rigs land as root dot-files;
# anything worth keeping graduates into scripts/verify/)
/.*.mjs
!/.prettierrc.mjs
!/.stylelintrc.mjs
!/.template-lintrc.mjs

# build data (downloaded source files for dictionary builds)
/scripts/data/

# package-lock.json is tracked on purpose: CF Pages can't read the text-format
# bun.lock and would otherwise npm-install unpinned (broke the 2026-07-24 deploy)
