# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# package-lock.json is tracked on purpose: CF Pages can't read the text-format
# bun.lock and would otherwise npm-install unpinned (broke the 2026-07-24 deploy)

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local design sketches / mockups (not shipped)
/sketches/

# claude
CLAUDE.md
DESIGN.md
/docs
.superpowers/
.claude/scheduled_tasks.lock

# session scratch (one-off debug/repro rigs land as root dot-files;
# anything worth keeping graduates into scripts/verify/)
/.*.mjs

# build data (downloaded source files for dictionary builds)
scripts/data/
