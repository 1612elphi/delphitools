{
	"extends": "@ember/app-tsconfig",
	"include": ["app", "tests", "types"],
	"compilerOptions": {
		"allowJs": true,
		"paths": {
			"delphitools-v2/tests/*": ["./tests/*"],
			"delphitools-v2/*": ["./app/*"],
			"*": ["./types/*"]
		},
		"types": [
			"ember-source/types",
			"@embroider/core/virtual",
			"vite/client",
			"@glint/ember-tsc/types"
		]
	}
}
