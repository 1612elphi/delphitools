	"exports": {
		"./tests/*": "./tests/*",
		"./*": "./app/*"
	},
	"directories": {
		"doc": "doc",
		"test": "tests"
	},
	"scripts": {
		"build": "vite build",
		"build:static": "vite build && node scripts/prerender.mjs",
		"format": "prettier . --cache --write",
		"gen-icons": "node scripts/gen-icons.mjs",
		"lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
		"lint:css": "stylelint \"**/*.{css,scss}\"",
		"lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
		"lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && npm run format",
		"lint:format": "prettier . --cache --check",
		"lint:hbs": "ember-template-lint .",
		"lint:hbs:fix": "ember-template-lint . --fix",
		"lint:js": "eslint . --cache",
		"lint:js:fix": "eslint . --fix",
		"lint:types": "ember-tsc --noEmit",
		"prerender": "node scripts/prerender.mjs",
		"start": "vite",
		"test": "NODE_ENV=development vite build --mode development && ember test --path dist",
		"verify": "node scripts/verify/all.mjs",
		"verify:model": "node scripts/verify/bg-removal.mjs",
		"verify:pdf-compressor": "node scripts/verify/pdf-compressor.mjs",
		"verify:static": "node scripts/verify/static.mjs"
	},
